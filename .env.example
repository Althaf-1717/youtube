# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Service Role Key for server-side elevated administrative operations
# Keep this strictly private and never expose it to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Restrict dashboard access to a specific administrator email
ADMIN_EMAIL=admin@arhastudio.com
